<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Library, playback and local recommendations remain on-device. Internet is
         used only after the user explicitly enables the optional AI similarity beta. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Local video tab: Android 13+ needs its own video permission (the audio one does not cover it).
         Before Android 13 the READ_EXTERNAL_STORAGE entry below covers videos too. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Only needed to delete/move tracks that this app didn't create, on legacy (pre-scoped-storage)
         Android 8-9. From Android 10 on, deleting/moving other apps' files goes through a
         MediaStore confirmation dialog instead (see TrackFileOps) and needs no extra permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="${marketPermission}" />

    <!-- Required since Android 11 (targetSdk here is 35): without declaring visibility to
         Myket's package, PackageManager can't resolve/bind ir.mservices.market's billing
         service, so IabHelper.startSetup() silently fails and every purchase() call returns
         "مایکت در دسترس نیست" — even with a correct IAB public key and on a device that has
         Myket installed. This is what Myket's review flagged. -->
    <queries>
        <package android:name="ir.mservices.market" />
        <intent>
            <action android:name="ir.mservices.market.InAppBillingService.BIND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- Android Auto / Automotive (spec item 9): the phone-only build still installs fine —
         "required=false" just lets the app also show up on car head units and Assistant. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".AiMusicApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiMusicCompanion"
        tools:targetApi="34">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AiMusicCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Standalone video player. Handles rotation itself (no restart) and supports Picture-in-Picture. -->
        <activity
            android:name=".ui.video.VideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.AiMusicCompanion" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Legacy action Android Auto / Assistant use to discover a browsable media app. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.MusicWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

    </application>
</manifest>
